# ── Biometric and secret data — never commit ────────────────────────
# (patterns must be on their own line — a trailing "# comment" is treated
#  as part of the pattern by git, which silently disables the rule)
# consent tokens and per-subject salts:
data/consent/
# real subjects' calibration photos:
data/calib/*/
!data/calib/README.md
# Stage 2 corpus: re-fetched images, embeddings, post text — never commit:
data/index/*
!data/index/README.md
# run artifacts, including raw embeddings:
out/

# ── Environment ─────────────────────────────────────────────────────
.env
.venv/
venv/

# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ── Tooling ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.DS_Store

# Local consenting corpus + held-out probe photos — real people, never commit:
data/corpus/*/
!data/corpus/README.md
data/probe/
# Reference clones of teammates' branches (untracked working copies):
/person1/
/person2/
# Foundry download
foundry.zip
