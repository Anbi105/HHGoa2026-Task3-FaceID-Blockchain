# FaceProof — environment configuration.  Copy to .env and adjust.
# Every value below is optional; the defaults in faceproof/config.py apply
# when unset, and `python -m faceproof.cli config` prints what is in force.

# ── Quality gate (§5) ───────────────────────────────────────────────
# FACEPROOF_MIN_DET_SCORE=0.62
# FACEPROOF_MIN_FACE_PX=90
# FACEPROOF_MIN_BLUR_VAR=45.0
# FACEPROOF_MAX_SECONDARY_FACE_RATIO=0.60

# ── Matching (§6) — set from data/calibration.json, do NOT guess ────
# FACEPROOF_ACCEPT_AT=0.55
# FACEPROOF_REVIEW_AT=0.42
# FACEPROOF_MIN_MARGIN=0.06
# FACEPROOF_TOP_K=10
# FACEPROOF_PHASH_MAX_HAMMING=10

# ── Consent (§8) ────────────────────────────────────────────────────
# FACEPROOF_CONSENT_SCOPE=face_probe_demo
# FACEPROOF_CONSENT_TTL_DAYS=30

# ── Paths ───────────────────────────────────────────────────────────
# FACEPROOF_DATA_DIR=./data
# FACEPROOF_OUT_DIR=./out

# ── Serialisation (§7, D9) ──────────────────────────────────────────
# FACEPROOF_FLOAT_PRECISION=6

# ── Stage 3: chain (§9) ─────────────────────────────────────────────
# Read by faceproof/chain.py.  Unlike the FACEPROOF_* keys above these are
# unprefixed, because Foundry and most EVM tooling read the same names.
#
# CHAIN must name a network chain.py knows (anvil | amoy).  An unset CHAIN
# defaults to anvil; an unrecognised one is now an error rather than a silent
# fall back to localhost.
# CHAIN=anvil
# RPC_URL=http://127.0.0.1:8545
# REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Deployer / anchor key.  NEVER a key holding real funds, and never commit a
# populated .env (it is gitignored).  The value below is Anvil's world-known
# dev account 0 — safe precisely because everyone already has it.
# PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Polygon Amoy example (fund a throwaway key from the Polygon faucet first):
# CHAIN=amoy
# RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# REGISTRY_ADDRESS=0xeE0efb2a3D75f1933f171dE8e8D9Dd14903170d3

# ── Stage 2: Channel B (§6) — optional, opt-in ──────────────────────
# Reverse-image search. Leaving this unset keeps Channel B disabled, which is
# the default posture: enabling it transmits a cropped face to a third party.
# SERPAPI_KEY=
