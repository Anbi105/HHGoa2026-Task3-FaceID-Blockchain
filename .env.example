# FaceProof — environment configuration.  Copy to .env and adjust.
# Every value below is optional; the defaults in faceproof/config.py apply
# when unset, and `python -m faceproof.cli config` prints what is in force.

# ── Quality gate (§5) ───────────────────────────────────────────────
# FACEPROOF_MIN_DET_SCORE=0.62
# FACEPROOF_MIN_FACE_PX=90
# FACEPROOF_MIN_BLUR_VAR=45.0
# FACEPROOF_MAX_SECONDARY_FACE_RATIO=0.60

# ── Matching (§6) — set from data/calibration.json, do NOT guess ────
# FACEPROOF_ACCEPT_AT=0.55
# FACEPROOF_REVIEW_AT=0.42
# FACEPROOF_MIN_MARGIN=0.06
# FACEPROOF_TOP_K=10
# FACEPROOF_PHASH_MAX_HAMMING=10

# ── Consent (§8) ────────────────────────────────────────────────────
# FACEPROOF_CONSENT_SCOPE=face_probe_demo
# FACEPROOF_CONSENT_TTL_DAYS=30

# ── Paths ───────────────────────────────────────────────────────────
# FACEPROOF_DATA_DIR=./data
# FACEPROOF_OUT_DIR=./out

# ── Serialisation (§7, D9) ──────────────────────────────────────────
# FACEPROOF_FLOAT_PRECISION=6
